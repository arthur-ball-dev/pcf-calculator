# PCF Calculator Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="PCF Calculator API"
APP_VERSION="1.0.0"
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql+psycopg://pcf_user:DB_PASSWORD@localhost:5432/pcf_calculator

# PostgreSQL (Production) - Uncomment and configure for production
# DATABASE_URL=postgresql://user:password@localhost:5432/pcf_calculator

# PostgreSQL with Supabase - Example format
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# PostgreSQL Pooled Connection (for PgBouncer/Supabase pooler)
# DATABASE_URL_POOLED=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# =============================================================================
# DATABASE POOL SETTINGS (for PostgreSQL)
# =============================================================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# SUPABASE SETTINGS (optional - for direct Supabase API access)
# =============================================================================
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=eyJ...

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed origins for CORS
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Railway deployment URL (auto-added to CORS origins if set)
# RAILWAY_PUBLIC_URL=https://your-app.railway.app

# =============================================================================
# API SETTINGS
# =============================================================================
API_V1_PREFIX=/api/v1

# =============================================================================
# REDIS SETTINGS
# =============================================================================
# Redis connection settings for Celery message broker and result backend

# Redis host (use 'redis' for Docker Compose, 'localhost' for local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CELERY SETTINGS
# =============================================================================
# Celery broker and result backend URLs
# For Docker Compose: use 'redis' as hostname
# For local development: use 'localhost'

# Development (local Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Docker Compose (uncomment these when using docker-compose)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
# Tihese settings are used when running the application in Docker containers

# Python path for Docker containers
# PYTHONPATH=/app

# Compose project name (optional - defaults to directory name)
# COMPOSE_PROJECT_NAME=pcf-calculator