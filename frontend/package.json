    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "immer": "^11.2.9",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-joyride": "3.2.0",
    "react-swipeable": "^7.0.2",
