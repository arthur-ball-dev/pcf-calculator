{
  "name": "pcf-calculator-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_PROD_BUILD=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:setup": "python ../backend/scripts/setup_test_db.py",
    "test:e2e:isolated": "npm run test:e2e:setup && DATABASE_URL=postgresql+psycopg://pcf_user:${PCF_DB_PASSWORD:-DB_PASSWORD}@localhost:5432/pcf_calculator_test playwright test"
  },
